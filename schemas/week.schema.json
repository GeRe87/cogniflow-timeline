{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://odea-project.github.io/cogniflow-timeline/schemas/week.schema.json",
  "title": "CogniFlow published week",
  "type": "object",
  "additionalProperties": false,
  "required": ["week", "start", "end", "summary", "areas", "contributors"],
  "properties": {
    "week": {
      "type": "string",
      "pattern": "^[0-9]{4}-W[0-9]{2}$"
    },
    "start": {"type": "string", "format": "date"},
    "end": {"type": "string", "format": "date"},
    "summary": {
      "type": "string",
      "minLength": 40,
      "maxLength": 420
    },
    "areas": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      }
    },
    "contributors": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": ["gerrit", "ricardo"]
      }
    }
  }
}
