{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://odea-project.github.io/cogniflow-timeline/schemas/contribution.schema.json",
  "title": "CogniFlow weekly contribution",
  "type": "object",
  "additionalProperties": false,
  "required": ["week", "author", "source_window", "summary", "areas"],
  "properties": {
    "week": {
      "type": "string",
      "pattern": "^[0-9]{4}-W[0-9]{2}$"
    },
    "author": {
      "type": "string",
      "enum": ["gerrit", "ricardo"]
    },
    "source_window": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "end"],
      "properties": {
        "start": {"type": "string", "format": "date"},
        "end": {"type": "string", "format": "date"}
      }
    },
    "summary": {
      "type": "string",
      "minLength": 40,
      "maxLength": 420
    },
    "areas": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      }
    }
  }
}
